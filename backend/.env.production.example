# Reference only: inject these variables privately into the production runtime.
# This filename is NOT loaded automatically by the app. Do not commit real values.
APP_ENV=production
AUTO_BOOTSTRAP=0
# Required: stable, privately generated high-entropy signing key.
SECRET_KEY=
# Required: approved durable PostgreSQL URL, with the provider's TLS options.
DATABASE_URL=
PORT=8000
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
LOG_LEVEL=info
# Restrictive default; replace only after verifying the actual ingress topology.
FORWARDED_ALLOW_IPS=127.0.0.1
SESSION_LIFETIME_SECONDS=43200
ADMIN_IDLE_MINUTES=30
# Supply these privately ONLY to the separately authorized provisioning job.
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_PASSWORD=
